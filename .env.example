GROQ_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key
# From https://aistudio.google.com/apikey - used to generate lesson documentation/quizzes
# via Gemini 2.5 Flash (backend/services/ingestion/gemini_generator.py), not by the live chat.
GEMINI_API_KEY=your-api-key
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/learnwise
JWT_SECRET_KEY=your-secret-key-here

# Comma-separated list of origins allowed to call the API (e.g. the React dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Optional - if unset, verification/reset emails are just printed to the console (dev mode)
RESEND_API_KEY=
EMAIL_FROM=LearnWise <onboarding@resend.dev>